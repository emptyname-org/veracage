#!/usr/bin/env python3
"""Veracage privileged helper.

Invoked as root via pkexec. Sequence:

    1. fork()
    2. child:
         a. unshare(CLONE_NEWNS), make / rslave
         b. cryptsetup --type tcrypt open VAULT veracage-XXXX  (prompts for password)
         c. mount /dev/mapper/veracage-XXXX MOUNTPOINT (nodev,nosuid)
         d. drop privileges to the PKEXEC_UID caller (setresgid/setresuid)
         e. exec(continuation)
    3. parent:
         a. waitpid(child)
         b. cryptsetup close veracage-XXXX

The mount is created inside the child's mount NS only — invisible to the
host. The dm-crypt device (`/dev/mapper/veracage-XXXX`) IS globally
visible to root (kernel limitation, documented in §3 of the design).

SECURITY: this helper is reachable by any active local user via pkexec
(polkit `auth_self_keep`). It must therefore NOT trust caller-supplied
identity or code paths. The uid/gid to drop to come from PKEXEC_UID (set
by pkexec to the real caller); the continuation is pinned to this helper's
own install tree; forwarded env vars are allowlisted. A direct
`pkexec veracage-helper --user 0 --continuation /bin/sh` therefore can't
yield a root shell — those arguments no longer exist.
"""
from __future__ import annotations

import argparse
import ctypes
import hashlib
import os
import pwd
import secrets
import signal
import subprocess
import sys
from pathlib import Path

LOCKS_DIR = Path("/run/veracage")

# Env vars the launcher may forward into the (unprivileged) continuation.
# pkexec strips the environment; the launcher re-supplies these via
# --setenv. Anything outside this set is dropped, so a direct pkexec
# caller can't smuggle e.g. LD_PRELOAD/LD_LIBRARY_PATH through us.
_ALLOWED_SETENV = frozenset({
    "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "XDG_SESSION_TYPE", "DISPLAY", "LANG",
})


def _vault_hash(p: str) -> str:
    return hashlib.sha256(p.encode()).hexdigest()[:16]


def _write_lock(lock: Path, dm_name: str, mountpoint: str, uid: int) -> None:
    lock.parent.mkdir(mode=0o755, exist_ok=True)
    body = f"dm_name={dm_name}\nmountpoint={mountpoint}\nuser_uid={uid}\n"
    lock.write_text(body)
    lock.chmod(0o600)

# --- syscall wrappers ------------------------------------------------------

CLONE_NEWNS = 0x00020000
MS_REC      = 16384
MS_SLAVE    = 1 << 19

_libc = ctypes.CDLL("libc.so.6", use_errno=True)


def _check(rc: int, what: str) -> None:
    if rc != 0:
        e = ctypes.get_errno()
        raise OSError(e, f"{what}: {os.strerror(e)}")


def unshare_mount_ns() -> None:
    _check(_libc.unshare(CLONE_NEWNS), "unshare(CLONE_NEWNS)")


def make_root_rslave() -> None:
    _check(
        _libc.mount(None, b"/", None, MS_REC | MS_SLAVE, None),
        "mount --make-rslave /",
    )


# --- main ------------------------------------------------------------------

def fail(msg: str, code: int = 1) -> None:
    print(f"veracage-helper: {msg}", file=sys.stderr)
    sys.exit(code)


def resolve_caller(environ) -> tuple[int, int]:
    """Return (uid, gid) of the invoking user, taken from PKEXEC_UID.

    NEVER trust a caller-supplied uid/gid: this helper is reachable by any
    active local user via pkexec, so honouring an argv uid would let them
    pass `--user 0` and obtain a root shell. pkexec sets PKEXEC_UID to the
    real caller's uid; the primary gid comes from the passwd database.
    """
    raw = environ.get("PKEXEC_UID")
    if raw is None or not raw.isdigit():
        raise PermissionError("PKEXEC_UID not set; refusing to run outside pkexec")
    uid = int(raw)
    if uid == 0:
        raise PermissionError("refusing to run for a root caller")
    try:
        gid = pwd.getpwuid(uid).pw_gid
    except KeyError:
        raise PermissionError(f"unknown caller uid {uid}") from None
    return uid, gid


def continuation_path() -> Path:
    """Absolute path to the trusted continuation (src/bin/veracage).

    Pinned relative to this helper's own (polkit-pinned) location so the
    caller cannot redirect us at an arbitrary executable.
    """
    return Path(__file__).resolve().parent.parent / "src" / "bin" / "veracage"


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--vault", required=True)
    p.add_argument("--mountpoint", required=True)
    p.add_argument("--setenv", action="append", default=[], metavar="KEY=VALUE",
                   help="env var to set before exec'ing the continuation; "
                        "needed because pkexec strips most of the environment. "
                        "Restricted to an allowlist (see _ALLOWED_SETENV).")
    p.add_argument("rest", nargs=argparse.REMAINDER,
                   help="argv to pass to the continuation after `--`")
    args = p.parse_args()

    if os.geteuid() != 0:
        fail("must be invoked as root (via pkexec)", 2)

    # Identity comes from pkexec, never from argv (see resolve_caller).
    try:
        caller_uid, caller_gid = resolve_caller(os.environ)
    except PermissionError as e:
        fail(str(e), 2)

    vault = Path(args.vault).resolve()
    if not vault.is_file():
        fail(f"vault not found: {vault}", 2)

    mountpoint = Path(args.mountpoint).resolve()
    if not str(mountpoint).startswith("/run/veracage/"):
        fail(f"mountpoint must be under /run/veracage/: {mountpoint}", 2)

    cont = continuation_path()
    if not cont.is_file() or not os.access(cont, os.X_OK):
        fail(f"continuation not executable: {cont}", 2)

    # Strip the leading "--" if argparse left it
    rest = list(args.rest)
    if rest and rest[0] == "--":
        rest = rest[1:]

    # Name the dm-crypt device so we know what to close.
    dm_name = f"veracage-{secrets.token_hex(6)}"
    dm_path = Path(f"/dev/mapper/{dm_name}")

    # Make sure /run/veracage exists (host-visible parent dir, owned root)
    Path("/run/veracage").mkdir(mode=0o755, exist_ok=True)

    # Lock file used by `veracage-cleanup` (systemd ExecStopPost) so that
    # even a SIGKILL of the launcher leaves a recoverable trail.
    lock_file = LOCKS_DIR / f"{_vault_hash(str(vault))}.lock"
    _write_lock(lock_file, dm_name, str(mountpoint), caller_uid)

    pid = os.fork()
    if pid == 0:
        # ---------------- child ----------------
        try:
            unshare_mount_ns()
            make_root_rslave()

            mountpoint.mkdir(mode=0o700, parents=True, exist_ok=True)
            os.chown(mountpoint, caller_uid, caller_gid)

            # Open the TrueCrypt/VeraCrypt volume. Prompts on tty.
            r = subprocess.run(
                ["cryptsetup", "--type", "tcrypt",
                 "--veracrypt", "open", str(vault), dm_name],
                check=False,
            )
            if r.returncode != 0:
                fail(f"cryptsetup open failed: {r.returncode}", r.returncode)

            r = subprocess.run(
                ["mount", "-o", "nodev,nosuid",
                 str(dm_path), str(mountpoint)],
                check=False,
            )
            if r.returncode != 0:
                # try to roll back the dm device before exiting
                subprocess.run(["cryptsetup", "close", dm_name])
                fail(f"mount failed: {r.returncode}", r.returncode)

            # Drop privileges to the pkexec caller (gid first, then uid).
            os.setgroups([])
            os.setresgid(caller_gid, caller_gid, caller_gid)
            os.setresuid(caller_uid, caller_uid, caller_uid)

            # Re-establish the handful of env vars pkexec stripped. Only
            # allowlisted keys are honoured (see _ALLOWED_SETENV) so a
            # caller can't inject e.g. LD_PRELOAD into the continuation.
            for kv in args.setenv:
                k, _, v = kv.partition("=")
                if k in _ALLOWED_SETENV:
                    os.environ[k] = v

            # Hand off to the continuation. Replaces this process; mount NS
            # persists in the descendants until they all exit.
            os.execv(str(cont), [str(cont)] + rest)
            # NOTREACHED
            os._exit(127)
        except Exception as e:  # pragma: no cover
            print(f"veracage-helper child: {e!r}", file=sys.stderr)
            os._exit(1)

    # ---------------- parent (still root, original mount NS) ----------------
    # Forward common signals so Ctrl+C in the user's terminal tears down
    # the child cleanly.
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda s, f: os.kill(pid, s))

    _, status = os.waitpid(pid, 0)
    rc = os.waitstatus_to_exitcode(status)

    # Clean up the dm-crypt device. The mountpoint disappeared with the
    # child's mount NS, so there's nothing to umount in this NS.
    if dm_path.exists():
        subprocess.run(["cryptsetup", "close", dm_name], check=False)

    # Best-effort: remove the (host-visible) empty mountpoint dir.
    try:
        mountpoint.rmdir()
    except OSError:
        pass

    # Remove our lock so the systemd ExecStopPost cleanup is a no-op.
    try:
        lock_file.unlink()
    except FileNotFoundError:
        pass

    return rc


if __name__ == "__main__":
    sys.exit(main())
