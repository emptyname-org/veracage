#!/usr/bin/env python3
"""Veracage cleanup helper (installed copy) — root via pkexec.

Generated by `make install` from install/veracage-cleanup.in. pkexec strips
the environment, so the package location is baked in (@LIBDIR@) rather than
read from VERACAGE_* env. See src/veracage/cleanup.py for the logic.
"""
import sys

sys.path.insert(0, "@LIBDIR@")
from veracage.cleanup import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
