<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Template. `make install` / `make install-dev` substitute @HELPER@ and
  @CLEANUP@ with the absolute paths of the installed helpers. The generated
  org.veracage.policy is not checked in (it is host-specific).
-->
<policyconfig>

  <vendor>Veracage</vendor>
  <vendor_url>https://example.invalid/veracage</vendor_url>

  <action id="org.veracage.helper">
    <description>Open or close an encrypted volume (LUKS or VeraCrypt) in an isolated workspace</description>
    <message>Authenticate to open or close the volume</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_self_keep</allow_active>
    </defaults>
    <!--
      One action, because polkit keys an action to the pkexec'd program PATH and
      every privileged operation is this one helper: the mount, the per-volume
      close (the helper's close-volume flag), and the compositor bring-up. So the
      wording has to cover them all rather than say "open", which is what a close
      prompt used to read.

      Mind the punctuation: a double hyphen cannot appear inside an XML comment,
      and a policy file that is not well-formed is dropped WHOLE by polkitd. Both
      actions then vanish, pkexec falls back to org.freedesktop.policykit.exec,
      and every call asks for a password: the compositor, the session, and the
      cleanup that is meant to be passwordless.
    -->
    <annotate key="org.freedesktop.policykit.exec.path">@HELPER@</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <!--
    Cleanup is the crash-safe teardown path (systemd scope ExecStopPost). That
    pkexec runs from the user systemd manager, which polkit may treat as an
    *inactive* (not active) session, so it MUST be passwordless (allow_active +
    allow_inactive = yes) or the on-crash dismount silently fails.
    Passwordless is made SAFE by the helper, not by the policy: cleanup.py
    refuses unless PKEXEC_UID (the real caller pkexec vouches for) matches the
    session's recorded owner uid — so a local user cannot aim it at another
    user's session. It also only ever acts on a validated /run/veracage/<16-hex>
    .lock, only closes a veracage-<12-hex> dm device, and only tears down the
    session scratch/socket after a *successful* close. allow_any stays
    auth_admin (no remote/sessionless access).
    VERIFY on the target compositor that ExecStopPost cleanup actually fires.
  -->
  <action id="org.veracage.cleanup">
    <description>Close a Veracage dm-crypt device and remove its lock file</description>
    <message>Cleaning up a Veracage session</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CLEANUP@</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
