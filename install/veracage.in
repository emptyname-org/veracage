#!/usr/bin/env python3
"""Veracage launcher (installed copy).

Generated by `make install` from install/veracage.in: @LIBDIR@ / @LIBEXEC@
are substituted with the install paths. Puts the package on sys.path and
points the CLI at the installed privileged helpers (these env vars must
match the polkit policy's exec.path).
"""
import os
import sys

sys.path.insert(0, "@LIBDIR@")
os.environ.setdefault("VERACAGE_HELPER", "@LIBEXEC@/veracage-helper")
os.environ.setdefault("VERACAGE_CLEANUP_HELPER", "@LIBEXEC@/veracage-cleanup")
os.environ.setdefault("VERACAGE_AGENT", "@AGENT@")
os.environ.setdefault("VERACAGE_COMPOSITOR", "@COMPOSITOR@")

from veracage.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
