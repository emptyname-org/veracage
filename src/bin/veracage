#!/usr/bin/env python3
"""Veracage entry script. Tiny wrapper that adds src/ to sys.path and runs the CLI."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from veracage.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
